set -eu

editor_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if ! command -v cargo >/dev/null 2>&1; then
    printf '%s\n' 'エディターの起動にはRustとCargoが必要です。' >&2
    exit 127
fi

# WSLg: use X11 and CPU rendering to avoid the EGL/Zink startup failure.
if [ -n "${WSL_DISTRO_NAME:-}${WSL_INTEROP:-}" ]; then
    unset WAYLAND_DISPLAY WAYLAND_SOCKET
    export LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-true}"
    # Xcursor otherwise derives 45px cursors from a 2160px WSLg desktop.
    export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
    export GALLIUM_DRIVER="${GALLIUM_DRIVER:-llvmpipe}"
fi

# Keep the caller's working directory so relative project paths still work.
exec cargo run --quiet --locked \
    --manifest-path "$editor_root/tools/modkit/Cargo.toml" \
    -p lom-editor -- "$@"
